# Steward server configuration (ADR-0004). Copy to .env for local dev.
# The OAuth app's callback URL must be <origin>/auth/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# openssl rand -hex 32
SESSION_SECRET=
# owner/name of the data-repo template
STEWARD_DATA_REPO_TEMPLATE=devord/steward-data-template
# prefix for per-user data repos (default shown)
STEWARD_DATA_REPO_PREFIX=steward-data-

# Sentry (ADR-0058). Absent — the normal state locally — means the SDK never
# initializes and the browser never downloads it. Set both of these together
# to make a local run report: the sample-rate table is keyed by deploy tier
# and fails closed, so a DSN alone still collects nothing.
# SENTRY_DSN=
# VERCEL_ENV=development
